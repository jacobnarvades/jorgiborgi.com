{
  "name": "jacob-site",
  "compatibility_date": "2026-10-01",
  // Only /media/* runs the Worker (adds Range support for video);
  // every other path is served straight from public/.
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*"]
  },
  "routes": [
    { "pattern": "jorgiborgi.com", "custom_domain": true },
    { "pattern": "www.jorgiborgi.com", "custom_domain": true }
  ]
}
